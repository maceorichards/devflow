+# A test path has a test/tests/spec/__tests__ directory segment or a test-style
+# basename (test_*, *_test.*, *.test.*, *.spec.*, *Test.*, *Tests.*).
+is_test_path() {
+  case "/$1" in */test/*|*/tests/*|*/spec/*|*/__tests__/*) return 0 ;; esac
+  case "${1##*/}" in test_*|*_test.*|*.test.*|*.spec.*|*Test.*|*Tests.*) return 0 ;; esac
+  return 1
+}
+
 {
   echo "# Review package: ${base}..${head}"
   echo
@@ -45,6 +60,22 @@
   echo "## Files changed"
   git diff --stat "${base}..${head}"
   echo
+  if [ -n "$tc" ]; then
+    # Acceptance-test files = the test files TEST_COMMIT added or changed;
+    # every file it touched when none match a test-path pattern.
+    files=()
+    all=()
+    while IFS= read -r f; do
+      all+=("$f")
+      if is_test_path "$f"; then files+=("$f"); fi
+    done < <(git diff-tree --root --no-commit-id --name-only -r --diff-filter=d "$tc")
+    if [ ${#files[@]} -eq 0 ] && [ ${#all[@]} -gt 0 ]; then files=("${all[@]}"); fi
+    echo "## Acceptance-test changes since $(git rev-parse --short "$tc")"
+    tdiff=""
+    [ ${#files[@]} -eq 0 ] || tdiff=$(git diff -U10 "${tc}..${head}" -- "${files[@]}")
+    if [ -n "$tdiff" ]; then printf '%s\n' "$tdiff"; else echo "none"; fi
+    echo
+  fi
   echo "## Diff"
   git diff -U10 "${base}..${head}"
 } > "$out"
